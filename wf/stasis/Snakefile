rule beast2_freedate_xml:
    """Generate free-date BEAST2 XML from codon_tipdating.xml.
    Uses pos1+2 only; ancient_consensus tip date is a free parameter
    with Uniform(1.87–2.70 Ma) geological prior (Khampung permafrost age).
    """
    input:
        xml = f"{PHYLO_DIR}/09_beast2/codon_tipdating.xml"
    output:
        xml = f"{PHYLO_DIR}/09_beast2/stasis_analysis/codon_freedate.xml"
    params:
        script = f"{PHYLO_DIR}/09_beast2/make_freedate_xml.py"
    log: f"{PHYLO_DIR}/logs/beast2_freedate_xml.log"
    resources:
        mem_mb          = 4000,
        runtime         = 5,
        slurm_partition = "compregular"
    shell:
        "python3 {params.script} > {log} 2>&1"


rule beast2_freedate_run:
    """Run BEAST2 free-date: 2 independent chains on CPU 32-thread (30M steps).
    CPU 32-thread (4m38s/Msamples) confirmed faster than GPU for this
    single 2938-site partition. Rep1: seed=12345; Rep2: seed=67890.
    Both chains run in parallel via background sbatch --wait.
    """
    input:
        xml = f"{PHYLO_DIR}/09_beast2/stasis_analysis/codon_freedate.xml"
    output:
        log1   = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep1/codon_freedate.log",
        trees1 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep1/codon_freedate.trees",
        log2   = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep2/codon_freedate.log",
        trees2 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep2/codon_freedate.trees"
    params:
        beagle_lib = config["beagle_lib"],
        workdir    = f"{PHYLO_DIR}/09_beast2/stasis_analysis",
        beast2_bin = "/maps/projects/caeg/people/kbd606/scratch/kapk-assm/amber/beast2_2.7/beast/bin/beast"
    log: f"{PHYLO_DIR}/logs/beast2_freedate_run.log"
    shell:
        """
        mkdir -p {params.workdir}/rep1 {params.workdir}/rep2

        sbatch --wait \
            --job-name=beast_fd_rep1 \
            --partition=compregular \
            --cpus-per-task=32 \
            --mem=32G \
            --time=4:00:00 \
            --output={params.workdir}/rep1/slurm_%j.out \
            --wrap='
                export LD_LIBRARY_PATH="{params.beagle_lib}:${{LD_LIBRARY_PATH:-}}"
                cd {params.workdir}
                "{params.beast2_bin}" -beagle_CPU -beagle_SSE -threads 32 -seed 12345 \
                    -prefix "rep1/" -overwrite codon_freedate.xml
            ' &
        PID1=$!

        sbatch --wait \
            --job-name=beast_fd_rep2 \
            --partition=compregular \
            --cpus-per-task=32 \
            --mem=32G \
            --time=4:00:00 \
            --output={params.workdir}/rep2/slurm_%j.out \
            --wrap='
                export LD_LIBRARY_PATH="{params.beagle_lib}:${{LD_LIBRARY_PATH:-}}"
                cd {params.workdir}
                "{params.beast2_bin}" -beagle_CPU -beagle_SSE -threads 32 -seed 67890 \
                    -prefix "rep2/" -overwrite codon_freedate.xml
            ' &
        PID2=$!

        wait $PID1 $PID2
        """


rule treeannotator_freedate:
    """MCC trees for both free-date replicates (10% burnin)."""
    input:
        trees1 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep1/codon_freedate.trees",
        trees2 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep2/codon_freedate.trees"
    output:
        mcc1 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep1/codon_freedate_mcc.tree",
        mcc2 = f"{PHYLO_DIR}/09_beast2/stasis_analysis/rep2/codon_freedate_mcc.tree"
    params:
        burnin        = config.get("beast2_burnin_pct", 10),
        treeannotator = "/maps/projects/caeg/people/kbd606/scratch/kapk-assm/amber/beast2_2.7/beast/bin/treeannotator",
        java_home     = "/maps/projects/fernandezguerra/apps/opt/conda/envs/java17/lib/jvm"
    log: f"{PHYLO_DIR}/logs/treeannotator_freedate.log"
    shell:
        """
        export JAVA_HOME="{params.java_home}"
        export PATH="{params.java_home}/bin:${{PATH}}"
        "{params.treeannotator}" -burnin {params.burnin} -height mean \
            {input.trees1} {output.mcc1} >> {log} 2>&1
        "{params.treeannotator}" -burnin {params.burnin} -height mean \
            {input.trees2} {output.mcc2} >> {log} 2>&1
        """


