rule genome_pnps:
    """Genome-wide pN/pS from MUMmer SNPs + Prodigal annotations (NG86 + JC).
    Reconstructs gene sequences for each sample using SOIL100000032-aligned SNPs,
    compares codon-by-codon across all 1571 reference genes.
    """
    input:
        snps   = expand(
            f"{PHYLO_DIR}/10_snp_tree/snps/{{sample}}.snps",
            sample=["ancient_consensus", "modern_consensus", "s17_ancient_relative"]
        ),
        ref_genome = f"{PHYLO_DIR}/01_genomes/{config['snp_reference']}.fna",
        ref_gff    = f"{PHYLO_DIR}/02_prodigal/{config['snp_reference']}.gff"
    output:
        f"{PHYLO_DIR}/11_pnps/genome_pnps.tsv"
    params:
        snps_dir    = f"{PHYLO_DIR}/10_snp_tree/snps",
        prodigal_dir = f"{PHYLO_DIR}/02_prodigal",
        ref         = config["snp_reference"],
        pairs       = "ancient_consensus,s17_ancient_relative "
                      "ancient_consensus,modern_consensus "
                      "modern_consensus,s17_ancient_relative",
        env         = "/maps/projects/fernandezguerra/apps/opt/conda/envs/phylogenomics",
        script      = workflow.basedir + "/scripts/genome_pnps.py"
    log: f"{PHYLO_DIR}/logs/genome_pnps.log"
    resources:
        mem_mb          = 8000,
        runtime         = 30,
        slurm_partition = "compregular"
    shell:
        """
        set +u
        source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
        conda activate {params.env}
        mkdir -p $(dirname {output})
        python {params.script} \
            {params.snps_dir} {params.prodigal_dir} {params.ref} {output} \
            {params.pairs} 2> {log}
        """


rule compute_pnps:
    """pN/pS (dN/dS) across 40 marker genes for key genome pairs.
    Uses Nei-Gojobori 1986 method on per-gene codon alignments.
    Pairs: ancient vs S17, ancient vs modern, ancient vs NAY3300025461b7,
           ancient vs SOIL100000032, modern vs S17.
    """
    input:
        expand(
            f"{PHYLO_DIR}/06_trimmed/{{marker}}.codon.fna",
            marker=MARKERS
        )
    output:
        agg      = f"{PHYLO_DIR}/11_pnps/pnps_aggregate.tsv",
        per_gene = f"{PHYLO_DIR}/11_pnps/pnps_per_gene.tsv"
    params:
        codon_dir = f"{PHYLO_DIR}/06_trimmed",
        env       = "/maps/projects/fernandezguerra/apps/opt/conda/envs/phylogenomics",
        # KaKs_Calculator 2.0 (YN method) + biopython installed in phylogenomics env
        script    = workflow.basedir + "/scripts/compute_pnps.py"
    log: f"{PHYLO_DIR}/logs/compute_pnps.log"
    resources:
        mem_mb          = 4000,
        runtime         = 30,
        slurm_partition = "compregular"
    shell:
        """
        set +u
        source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
        conda activate {params.env}
        mkdir -p $(dirname {output.agg})
        python {params.script} {params.codon_dir} {output.agg} {output.per_gene} 2> {log}
        """


