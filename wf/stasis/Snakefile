if not SKIP_MAPPING:

    rule bowtie2_index:
        """Build bowtie2 index from assembly contigs."""
        input:
            contigs = config["contigs"]
        output:
            f"{OUTDIR}/mapping/index/assembly.1.bt2"
        params:
            prefix = f"{OUTDIR}/mapping/index/assembly",
            env    = ENV_ASSEMBLY
        threads: config["threads"]
        resources:
            mem_mb          = 32000,
            runtime         = 60,
            slurm_partition = "compregular"
        log: f"{OUTDIR}/logs/bowtie2_index.log"
        shell:
            """
            set +u
            source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
            conda activate {params.env}
            export LD_LIBRARY_PATH={params.env}/lib:$LD_LIBRARY_PATH
            mkdir -p $(dirname {output})
            bowtie2-build --threads {threads} {input.contigs} {params.prefix} 2>&1 | tee {log}
            """

    rule bowtie2_map:
        """Map reads with bowtie2 (-k 1000) and sort BAM — pipe avoids large SAM."""
        input:
            index = f"{OUTDIR}/mapping/index/assembly.1.bt2",
            reads = config["mapping"]["reads"]
        output:
            bam = f"{OUTDIR}/mapping/assembly.sorted.bam",
            bai = f"{OUTDIR}/mapping/assembly.sorted.bam.bai"
        params:
            idx_prefix = f"{OUTDIR}/mapping/index/assembly",
            k          = config["mapping"]["bowtie2_k"],
            env        = ENV_ASSEMBLY
        threads: config["mapping"]["threads"]
        resources:
            mem_mb          = 128000,
            runtime         = 480,
            slurm_partition = "compregular"
        log: f"{OUTDIR}/logs/bowtie2_map.log"
        shell:
            """
            set +u
            source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
            conda activate {params.env}
            export LD_LIBRARY_PATH={params.env}/lib:$LD_LIBRARY_PATH
            bowtie2 \
                -x {params.idx_prefix} \
                -k {params.k} \
                -D 15 -R 2 -L 22 -i S,1,1.15 \
                --np 1 --mp "1,1" --rdg "0,1" --rfg "0,1" \
                --score-min "L,0,-0.1" \
                -N 1 --threads {threads} \
                -U {input.reads} \
                2>{log} \
            | samtools sort -@ {threads} -m 4G -o {output.bam} -
            samtools index {output.bam}
            """

    rule filterbam_reassign:
        """EM-based multi-mapping reassignment via filterBAM."""
        input:
            bam = f"{OUTDIR}/mapping/assembly.sorted.bam"
        output:
            bam = f"{OUTDIR}/mapping/assembly.reassigned.bam"
        params:
            outdir         = f"{OUTDIR}/mapping",
            em_preset      = config["mapping"]["em_preset"],
            min_ani        = config["mapping"]["min_ani"],
            min_reads      = config["mapping"]["min_reads"],
            env            = ENV_ASSEMBLY,
            bam_filter_env = ENV_BAM_FILTER
        threads: config["mapping"]["threads"]
        resources:
            mem_mb          = 64000,
            runtime         = 360,
            slurm_partition = "compregular"
        log: f"{OUTDIR}/logs/filterbam_reassign.log"
        shell:
            """
            set +u
            source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
            conda activate {params.bam_filter_env}
            cd {params.outdir}
            filterBAM reassign \
                --bam {input.bam} \
                -t {threads} \
                --em-preset {params.em_preset} \
                -A {params.min_ani} \
                -n {params.min_reads} \
                -p assembly \
                2>&1 | tee {log}
            conda activate {params.env}
            export LD_LIBRARY_PATH={params.env}/lib:$LD_LIBRARY_PATH
            samtools index assembly.reassigned.bam
            """


