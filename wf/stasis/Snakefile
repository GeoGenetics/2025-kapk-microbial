rule validate_stasis:
    """
    Extreme validation of evolutionary stasis claim:
    - SNP damage artifact check (C>T / G>A enrichment)
    - Pairwise distances ancient vs modern vs all taxa (codon + SNP)
    - Deconvolution quality metrics (damage rates, fragment lengths)
    """
    input:
        codon_aln   = f"{PHYLO_DIR}/07_concatenated/concat_codon.fna",
        snp_aln     = f"{PHYLO_DIR}/10_snp_tree/snp_alignment_tvonly.fna",
        snps_dir    = f"{PHYLO_DIR}/10_snp_tree/snps",
        deconv_dir  = f"{OUTDIR}/deconvolve",
        resolve_dir = RESOLVE_DIR
    output:
        report = f"{PHYLO_DIR}/validation/stasis_validation_report.txt"
    log: f"{PHYLO_DIR}/logs/validate_stasis.log"
    script:
        "scripts/validate_stasis.py"


rule focal_pairwise_nucmer:
    """
    Direct pairwise nucmer alignment between focal genome pairs
    (ancient vs modern, ancient vs S17). Distinct from the reference-based
    SNP alignment: this gives the true pairwise distance between two genomes.
    """
    input:
        genome1 = lambda wc: {
            "ancient_vs_modern": f"{OUTDIR}/deconvolve/ancient_consensus.fa",
            "ancient_vs_s17":    f"{OUTDIR}/deconvolve/ancient_consensus.fa",
        }[wc.focal_pair],
        genome2 = lambda wc: {
            "ancient_vs_modern": f"{OUTDIR}/deconvolve/modern_consensus.fa",
            "ancient_vs_s17":    f"{OUTDIR}/s17_assembly/deconvolve/modern_consensus.fa",
        }[wc.focal_pair],
    output:
        delta    = f"{PHYLO_DIR}/11_focal_snps/{{focal_pair}}.delta",
        filtered = f"{PHYLO_DIR}/11_focal_snps/{{focal_pair}}.filter",
        snps     = f"{PHYLO_DIR}/11_focal_snps/{{focal_pair}}.snps",
    params:
        prefix = f"{PHYLO_DIR}/11_focal_snps/{{focal_pair}}",
        minlen = config["nucmer_minmatch"],
        env    = "/maps/projects/fernandezguerra/apps/opt/conda/envs/bioinfo",
    log: f"{PHYLO_DIR}/logs/focal_snps/{{focal_pair}}.log"
    resources:
        mem_mb   = 8000,
        runtime  = 30,
        slurm_partition = "compregular",
    shell:
        """
        set +u
        source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
        conda activate {params.env}
        mkdir -p $(dirname {output.delta})
        nucmer --maxmatch -p {params.prefix} {input.genome1} {input.genome2} 2> {log}
        delta-filter -r -q -l {params.minlen} {output.delta} > {output.filtered} 2>> {log}
        show-snps -CT {output.filtered} > {output.snps} 2>> {log}
        """


rule focal_pairwise_snp_table:
    """
    Count non-damage SNPs for each focal pair. C→T and G→A are excluded as
    aDNA deamination artefacts. Output TSV is read directly by the R figure script.
    """
    input:
        snps = expand(
            f"{PHYLO_DIR}/11_focal_snps/{{focal_pair}}.snps",
            focal_pair=["ancient_vs_modern", "ancient_vs_s17"],
        ),
    output:
        tsv = f"{PHYLO_DIR}/11_focal_snps/focal_pairwise_snp_counts.tsv",
    params:
        pairs = [
            ("ancient_vs_modern", f"{PHYLO_DIR}/11_focal_snps/ancient_vs_modern.snps"),
            ("ancient_vs_s17",    f"{PHYLO_DIR}/11_focal_snps/ancient_vs_s17.snps"),
        ],
    log: f"{PHYLO_DIR}/logs/focal_snps/pairwise_snp_table.log"
    script:
        "scripts/focal_pairwise_snp_table.py"


rule focal_fastani:
    """
    FastANI pairwise ANI between focal genome pairs (ancient vs modern, ancient vs S17).
    Output TSV is read directly by the R figure script for ANI labels on the phylogeny.
    """
    input:
        ancient = f"{OUTDIR}/deconvolve/ancient_consensus.fa",
        modern  = f"{OUTDIR}/deconvolve/modern_consensus.fa",
        s17     = f"{OUTDIR}/s17_assembly/deconvolve/modern_consensus.fa",
    output:
        tsv = f"{PHYLO_DIR}/11_focal_snps/focal_pairwise_ani.tsv",
    params:
        env = "/maps/projects/fernandezguerra/apps/opt/conda/envs/bioinfo",
    log: f"{PHYLO_DIR}/logs/focal_snps/focal_fastani.log"
    resources:
        mem_mb   = 4000,
        runtime  = 10,
        slurm_partition = "compregular",
    shell:
        """
        set +u
        source /maps/projects/fernandezguerra/apps/opt/conda/etc/profile.d/conda.sh
        conda activate {params.env}
        echo -e "pair\tani\tmatched_fragments\ttotal_fragments" > {output.tsv}
        fastANI -q {input.ancient} -r {input.modern} -o /dev/stdout 2>> {log} | \
            awk '{{print "ancient_vs_modern\t"$3"\t"$4"\t"$5}}' >> {output.tsv}
        fastANI -q {input.ancient} -r {input.s17} -o /dev/stdout 2>> {log} | \
            awk '{{print "ancient_vs_s17\t"$3"\t"$4"\t"$5}}' >> {output.tsv}
        """


