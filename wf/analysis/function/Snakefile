import os
import pandas as pd

configfile: "config.yaml"


def estimate_mmseqs_memory(wildcards, input, attempt):
    try:
        query_size_gb = os.path.getsize(input.faa) / (1024**3)
    except:
        query_size_gb = 10
    base_mem_gb = query_size_gb * 1.5 + 15
    mem_mb = int(base_mem_gb * 1024) + 32000 * (attempt - 1)
    return min(mem_mb, 400000)


def estimate_agp_memory(wildcards, input, attempt):
    try:
        input_size_gb = os.path.getsize(input.fastq) / (1024**3)
    except:
        input_size_gb = 10
    base_mem_gb = input_size_gb * 7 + 10
    mem_mb = int(base_mem_gb * 1024) + 16000 * (attempt - 1)
    return min(mem_mb, 128000)


def estimate_mmseqs_runtime(wildcards, input, attempt):
    try:
        query_size_mb = os.path.getsize(input.faa) / (1024**2)
    except:
        query_size_mb = 100
    base_runtime = 360 + int(query_size_mb / 100) * 30
    return base_runtime + 120 * (attempt - 1)


SAMPLE_MAPPING = pd.read_csv(
    config["real_samples"]["sample_mapping"],
    sep="\t"
).set_index("short_label")["file_label"].to_dict()

REAL_SAMPLES = list(SAMPLE_MAPPING.values())
OUTDIR = config["output_dir"]

include: "rules_emi.smk"


rule all:
    """Run the full DART pipeline: KEGG, CAZy, and viral annotation for all samples."""
    input:
        expand(f"{OUTDIR}/kegg/{{sample}}/pathway_damage_stats.tsv", sample=REAL_SAMPLES),
        expand(f"{OUTDIR}/kegg/{{sample}}/anvio_modules.txt", sample=REAL_SAMPLES),
        expand(f"{OUTDIR}/cazy/{{sample}}/cazy_emi.functional.tsv", sample=REAL_SAMPLES),
        expand(f"{OUTDIR}/viral/{{sample}}/viral_emi.functional.tsv", sample=REAL_SAMPLES)


# ============================================================================
# Gene prediction
# ============================================================================

rule agp_predict:
    input:
        fastq = lambda wc: config["real_samples"]["derep_dir"] + "/" + wc.sample + ".derep.non.fq.gz"
    output:
        gff = OUTDIR + "/sample_damage/{sample}/predictions.gff",
        faa = OUTDIR + "/sample_damage/{sample}/proteins.faa",
        agd = OUTDIR + "/sample_damage/{sample}/predictions.agd"
    params:
        agp          = config["agp_binary"],
        library_type = config["agp"]["library_type"],
        domain       = config["agp"]["domain"]
    threads: config["agp"]["threads"]
    retries: 3
    resources:
        runtime = 180,
        mem_mb  = estimate_agp_memory
    shell:
        """
        {params.agp} predict -i {input.fastq} -o {output.gff} \
            --fasta-aa {output.faa} --damage-index {output.agd} \
            --library-type {params.library_type} --domain {params.domain} --adaptive
        """


# ============================================================================
# KEGG pipeline
# ============================================================================

rule kegg_search:
    input:
        faa = OUTDIR + "/sample_damage/{sample}/proteins.faa"
    output:
        hits = OUTDIR + "/kegg/{sample}/kegg_hits.tsv"
    params:
        kegg_db = config["kegg"]["db"],
        vtml20  = config["vtml20_matrix"],
        mmseqs  = config["mmseqs_binary"]
    threads: config["mmseqs2"]["threads"]
    retries: 3
    resources:
        runtime = estimate_mmseqs_runtime,
        mem_mb  = estimate_mmseqs_memory
    shell:
        """
        mkdir -p $(dirname {output.hits})
        {params.mmseqs} easy-search {input.faa} {params.kegg_db} {output.hits} \
            $(dirname {output.hits})/tmp \
            --min-length 12 -e 10.0 --min-seq-id 0.86 -c 0.65 --cov-mode 2 \
            --format-output query,target,fident,alnlen,mismatch,gapopen,qstart,qend,tstart,tend,evalue,bits,qlen,tlen,qaln,taln \
            --comp-bias-corr 0 --mask 0 --exact-kmer-matching 1 \
            --sub-mat {params.vtml20} --seed-sub-mat {params.vtml20} \
            --search-type 1 -s 2 -k 6 --spaced-kmer-pattern 11011101 \
            --max-seqs 10000 --max-rejected 10 --threads {threads} \
            --remove-tmp-files 1 --use-all-table-starts 1
        """


rule kegg_damage_annotate:
    input:
        hits = OUTDIR + "/kegg/{sample}/kegg_hits.tsv",
        agd  = OUTDIR + "/sample_damage/{sample}/predictions.agd"
    output:
        annotated       = OUTDIR + "/kegg/{sample}/damage_annotated.tsv",
        protein_summary = OUTDIR + "/kegg/{sample}/protein_damage.tsv"
    params:
        agp = config["agp_binary"]
    resources:
        runtime = 30,
        mem_mb  = 8000
    shell:
        """
        {params.agp} damage-annotate --emi {input.hits} --damage-index {input.agd} \
            --auto-prior-ancient --auto-calibrate-spurious \
            -o {output.annotated} --protein-summary {output.protein_summary}
        """


